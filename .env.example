LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Local Ollama configuration used by the recorded diagnostic in this project.
# Comment out the OpenAI lines above, then uncomment these lines.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434
# Mem0 uses nomic-embed-text for Ollama embeddings (configured in mem0_engine.py).
CAUSALMEM_USER=default
CAUSALMEM_DB=data/causalmem.sqlite3
MEM0_PATH=data/mem0
# Optional override; defaults to a mem0-config sibling of MEM0_PATH.
# MEM0_DIR=data/mem0-config
